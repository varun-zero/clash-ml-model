# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyTorch checkpoints and model weights
checkpoints/*.pt
checkpoints/*.onnx
!checkpoints/.gitkeep
weights/*.pt
*.pt
*.onnx

# Raw VoD downloads, temporary datasets, and large cloned datasets
data/raw_vods/*
data/trajectories/*.npz
!data/trajectories/.gitkeep
data/cr_detection_dataset/

# Temporary / debug screenshots and crops
*.png
*.jpg
*.jpeg
!templates/**/*.png
!official_battle_log.png

# Environments & logs
.env
*.log
.vscode/
.idea/
unknown_cards/
.pytest_cache/
